<style>
  html { scroll-behavior: smooth; }

  .grid-pattern {
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  .hero-glow {
    background: radial-gradient(circle at 50% 40%, rgba(108, 92, 231, 0.35) 0%, rgba(108, 92, 231, 0) 60%);
  }

  /* Header com leve blur ao rolar a página */
  .site-header {
    backdrop-filter: blur(10px);
    background-color: rgba(10, 10, 15, 0.75);
  }

  /* Botões */
  .btn-primary, .btn-primary-sm, .btn-primary-lg {
    transition: box-shadow 250ms ease, transform 180ms ease, background-color 200ms ease;
  }
  .btn-primary:hover, .btn-primary-lg:hover {
    box-shadow: 0 10px 32px -6px rgba(108, 92, 231, 0.55);
    transform: translateY(-1px);
  }
  .btn-primary-sm:hover {
    box-shadow: 0 6px 20px -4px rgba(108, 92, 231, 0.5);
    transform: translateY(-1px);
  }
  .btn-primary:active, .btn-primary-sm:active, .btn-primary-lg:active {
    transform: translateY(0px) scale(0.98);
  }
  .btn-secondary, .btn-outline-sm, .btn-outline-lg {
    transition: border-color 200ms ease, color 200ms ease, background-color 200ms ease;
  }

  /* Vitrine */
  .card-available {
    transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
  }
  .card-available:hover {
    transform: translateY(-4px);
    border-color: #6C5CE7;
    box-shadow: 0 12px 40px -12px rgba(108, 92, 231, 0.4);
  }
  .preview-locked {
    filter: grayscale(45%) brightness(0.75);
  }

  /* Como Funciona */
  .step-connector::after {
    content: '';
    position: absolute;
    top: 28px;
    left: calc(50% + 32px);
    width: calc(100% - 64px);
    height: 1px;
    background: linear-gradient(to right, #6C5CE7, #232330);
  }
  .step-connector:last-child::after { display: none; }

  /* Benefícios */
  .benefit-card {
    transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
  }
  .benefit-card:hover {
    transform: translateY(-3px);
    border-color: #6C5CE7;
    box-shadow: 0 12px 32px -14px rgba(108, 92, 231, 0.4);
  }

  /* Preços */
  .card-vip {
    box-shadow: 0 20px 60px -20px rgba(108, 92, 231, 0.45);
  }

  /* Garantia */
  @keyframes ring-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(108, 92, 231, 0.35); }
    50% { box-shadow: 0 0 0 10px rgba(108, 92, 231, 0); }
  }
  .guarantee-ring { animation: ring-pulse 2.8s ease-in-out infinite; }

  /* FAQ (details/summary nativo) */
  .faq-item summary { list-style: none; cursor: pointer; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item .faq-icon { transition: transform 220ms ease; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-item[open] summary { color: #F5F5F7; }

  /* Menu mobile */
  #mobile-menu { transition: max-height 300ms ease, opacity 250ms ease; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .btn-primary, .btn-primary-sm, .btn-primary-lg,
    .btn-secondary, .btn-outline-sm, .btn-outline-lg,
    .card-available, .benefit-card, .faq-icon, .guarantee-ring,
    #mobile-menu { transition: none; animation: none; }
  }

  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid #8B7CF6;
    outline-offset: 3px;
  }
</style>
</head>

